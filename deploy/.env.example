# The values of compose.yaml. Copy this file to .env beside compose.yaml and
# set the three required ones. Keep .env private: it holds the installation's
# key and a password.

# Required. The installation's domain: Applications are at <name>.<domain>,
# the API at api.<domain>, sign-in at auth.<domain>.
VIBE_DOMAIN=

# Required. The installation's key: 32 random bytes in base64, made with
#   openssl rand -base64 32
# It seals the OIDC connection and the sessions in the platform database.
# Keep it as long as the data: with another key, OIDC must be connected again.
VIBE_SECRET_KEY=

# Required with the bundled Postgres (not with compose.own-postgres.yaml).
# The password of the bundled Postgres's role vibe, made with
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The address the installation is published on. Without it: 127.0.0.1, this
# machine only. 0.0.0.0 lets other machines in.
#VIBE_BIND=0.0.0.0

# The port browsers and the tool reach. Without it: 443.
#VIBE_HTTPS_PORT=443

# The program's image. Without it: the published image of this release.
#VIBE_IMAGE=ghcr.io/irvingouj/vibe:0.0.0

# Your company's own certificate authority, trusted beside the public ones:
# a file you put in the folder ca/, named as the container sees it. Without
# it: the public authorities alone.
#VIBE_CA_FILE=/etc/vibe/ca/company-ca.pem

# With compose.own-postgres.yaml only, and required then: your Postgres 18
# and the platform database in it, as a role that may create databases and
# roles.
#VIBE_DATABASE_URL=postgres://vibe:<password>@<host>:5432/vibe

# With compose.own-proxy.yaml only: where the program's own port is
# published, plain HTTP, for your reverse proxy. Without them: 127.0.0.1
# and 8080.
#VIBE_HTTP_BIND=127.0.0.1
#VIBE_HTTP_PORT=8080
